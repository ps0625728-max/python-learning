<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Furniture Price & Quotation List</title>
    <style>
        /* General Layout & Reset */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #f8f9fa;
            color: #333;
        }

        /* Navbar Style */
        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 10%;
            background-color: #3e2723; /* Wooden Brown Theme */
            color: white;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
            letter-spacing: 1px;
        }

        .contact-btn {
            padding: 10px 20px;
            background-color: #d84315;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
            transition: background 0.3s;
        }

        .contact-btn:hover {
            background-color: #bf360c;
        }

        /* Hero Section */
        .hero {
            background: linear-gradient(rgba(62, 39, 35, 0.85), rgba(62, 39, 35, 0.85)), url('https://unsplash.com') no-repeat center center/cover;
            color: white;
            height: 35vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 0 20px;
        }

        .hero h1 {
            font-size: 38px;
            margin-bottom: 10px;
        }

        .hero p {
            font-size: 16px;
            color: #ffccbc;
        }

        /* Search & Filter Section */
        .search-container {
            max-width: 900px;
            margin: 30px auto 10px auto;
            padding: 0 20px;
            display: flex;
            gap: 15px;
        }

        .search-box {
            flex: 1;
            padding: 12px 20px;
            font-size: 16px;
            border: 2px solid #bcaaa4;
            border-radius: 8px;
            outline: none;
            transition: border-color 0.3s;
        }

        .search-box:focus {
            border-color: #3e2723;
        }

        /* 📋 Table Section */
        .table-container {
            max-width: 900px;
            margin: 10px auto 50px auto;
            background: white;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            overflow-x: auto;
        }

        .quotation-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        .quotation-table th {
            background-color: #4e342e;
            color: white;
            padding: 15px;
            font-size: 16px;
            font-weight: 600;
        }

        .quotation-table td {
            padding: 15px;
            border-bottom: 1px solid #e0e0e0;
            font-size: 15px;
        }

        .quotation-table tr:hover {
            background-color: #efebe9;
        }

        .price-col {
            font-weight: bold;
            color: #d84315;
            font-size: 16px;
        }

        /* Footer / Contact Section */
        .footer-contact {
            background-color: #2d1a12;
            color: white;
            text-align: center;
            padding: 40px 20px;
        }

        .footer-contact h2 {
            margin-bottom: 15px;
        }

        .footer-contact p {
            color: #bcaaa4;
            margin-bottom: 20px;
        }

        .call-now {
            display: inline-block;
            padding: 12px 30px;
            background-color: #2ecc71;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            font-weight: bold;
            font-size: 16px;
        }
    </style>
</head>
<body>

    <!-- Header -->
    <header class="navbar">
        <div class="logo">🪑 Royal Furniture</div>
        <button class="contact-btn" onclick="scrollToContact()">Get Custom Quote</button>
    </header>

    <!-- Hero Section -->
    <section class="hero">
        <h1>Furniture Quotation & Price List</h1>
        <p>Premium quality wooden furniture at best wholesale rates</p>
    </section>

    <!-- Search Bar Section -->
    <div class="search-container">
        <input type="text" id="searchInput" class="search-box" placeholder="यहाँ फ़र्नीचर का नाम सर्च करें... (e.g. Bed, Sofa, Dining)" onkeyup="searchFurniture()">
    </div>

    <!-- 📊 Quotation Table Section -->
    <div class="table-container">
        <table class="quotation-table" id="furnitureTable">
            <thead>
                <tr>
                    <th>Furniture Item (फ़र्नीचर का नाम)</th>
                    <th>Material / Specification</th>
                    <th>Price (अनुमानित मूल्य)</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Luxury King Size Bed</td>
                    <td>Teak Wood with Storage (सागवान लकड़ी)</td>
                    <td class="price-col">₹2,30,000</td>
                </tr>
                <tr>
                    <td>Premium Queen Size Bed</td>
                    <td>Sheesham Wood (शीशम लकड़ी)</td>
                    <td class="price-col">₹1,45,000</td>
                </tr>
                <tr>
                    <td>L-Shape Premium Sofa Set</td>
                    <td>7 Seater with Fabric Cushions</td>
                    <td class="price-col">₹85,000</td>
                </tr>
                <tr>
                    <td>Wooden Dining Table Set</td>
                    <td>6 Seater with Glass Top</td>
                    <td class="price-col">₹65,000</td>
                </tr>
                <tr>
                    <td>Luxury Wardrobe (Almirah)</td>
                    <td>4-Door with Mirror Setup</td>
                    <td class="price-col">₹55,000</td>
                </tr>
                <tr>
                    <td>Modular Kitchen Cabinets</td>
                    <td>Waterproof Ply with Sunmica (Per Sq.Ft)</td>
                    <td class="price-col">₹1,200</td>
                </tr>
                <tr>
                    <td>Dressing Table</td>
                    <td>Modern Design with LED Lights</td>
                    <td class="price-col">₹18,500</td>
                </tr>
                <tr>
                    <td>Center Coffee Table</td>
                    <td>Solid Wood with Glass Top</td>
                    <td class="price-col">₹12,000</td>
                </tr>
                <tr>
                    <td>Office Study Table</td>
                    <td>With Drawers & Keyboard Tray</td>
                    <td class="price-col">₹8,500</td>
                </tr>
                <tr>
                    <td>TV Entertainment Unit</td>
                    <td>Wall Mounted Modern Design</td>
                    <td class="price-col">₹24,000</td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Contact Section -->
    <section id="contactSection" class="footer-contact">
        <h2>क्या आपको कस्टमाइज़्ड फ़र्नीचर चाहिए?</h2>
        <p>अपनी पसंद के हिसाब से साइज़ और डिज़ाइन बदलवाने के लिए हमसे अभी संपर्क करें।</p>
        <a href="tel:+919999999999" class="call-now">📞 Call Now: +91 99999 99999</a>
    </section>

    <!-- JavaScript For Live Search & Action -->
    <script>
        function searchFurniture() {
            let input = document.getElementById("searchInput").value.toUpperCase();
            let table = document.getElementById("furnitureTable");
            let tr = table.getElementsByTagName("tr");

            for (let i = 1; i < tr.length; i++) {
                let td = tr[i].getElementsByTagName("td")[0]; // Furniture Column
                if (td) {
                    let textValue = td.textContent || td.innerText;
                    if (textValue.toUpperCase().indexOf(input) > -1) {
                        tr[i].style.display = "";
                    } else {
                        tr[i].style.display = "none";
                    }
                }
            }
        }

        function scrollToContact() {
            document.getElementById('contactSection').scrollIntoView({ behavior: 'smooth' });
        }
    </script>
</body>
</html>
